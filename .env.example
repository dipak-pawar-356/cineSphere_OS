# ==============================================================================
# CineSphere OS - Enterprise Environment Configuration Example
# ==============================================================================

# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="CineSphere OS"
NEXT_PUBLIC_APP_TAGLINE="The Operating System for Modern Cinemas"

# Multi-Tenancy & Tenant Domain Resolution
NEXT_PUBLIC_ROOT_DOMAIN=cinesphere.io
NEXT_PUBLIC_DEFAULT_TENANT_ID=tenant-enterprise-hq

# API Gateway & Backend Services (Future Phase)
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
API_SECRET_KEY=your-secure-internal-gateway-token

# Authentication — Clerk (Phase 2 - Part 1)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/register
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/profile

# Legacy Auth Placeholder
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-32-character-secret-key-placeholder
AUTH_COOKIE_DOMAIN=.cinesphere.io

# Database & Cache (Future Phase - Prisma & Redis)
DATABASE_URL=postgresql://postgres:password@localhost:5432/cinesphere_db?schema=public
REDIS_URL=redis://localhost:6379

# Storage (Future Phase - AWS S3 / Cloudinary)
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=cinesphere-assets
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Payment Gateway (Future Phase - Razorpay / Stripe)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=

# Observability & Monitoring
NEXT_PUBLIC_SENTRY_DSN=
LOG_LEVEL=debug

